# ============================================================
# AgentHub API — required environment variables
# Copy to .env and fill in. NEVER commit .env.
# Placeholders only — real credentials are provided separately.
# ============================================================

# --- Core ---
# development | staging | production
ENVIRONMENT=development

# PostgreSQL only (async driver). No SQLite fallback.
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Disposable DB for the test suite (its tables are truncated between tests).
TEST_DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<TEST_DB_NAME>

# Connection tuning. DB_SSL_MODE: require | disable (use "disable" for a
# local dev Postgres without SSL). Set DB_USE_PGBOUNCER=true when connecting
# through a transaction-mode pooler (e.g. Supabase pooler / PgBouncer).
DB_SSL_MODE=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_USE_PGBOUNCER=false

# JWT signing secret. GENERATE A STRONG RANDOM VALUE:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In staging/production it must differ from the dev default and be >= 32 chars.
JWT_SECRET=<generate-a-strong-random-secret>
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Comma-separated allowed CORS origins (the frontend URL). Never "*" in production.
CORS_ORIGINS=http://localhost:3000

# --- LLM ---
# Provider implementation to use (anthropic | mock).
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT_SECONDS=45

# Direct Anthropic access (provided separately — never commit):
ANTHROPIC_API_KEY=<provided-separately>
# OR an Anthropic-compatible gateway (e.g. z.ai). If set, Bearer auth is used.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# Anthropic prompt caching: mark the stable system prompt + conversation
# prefix with cache_control breakpoints (roadmap §4.1).
LLM_PROMPT_CACHE_ENABLED=true

# --- Streaming (roadmap §3) ---
STREAMING_ENABLED=true
STREAM_MAX_SECONDS=120
MAX_CONCURRENT_STREAMS_PER_USER=2

# --- Redis (roadmap §5 / scale §2) ---
# Optional at runtime: empty or unreachable => the app degrades to
# in-memory rate limiting and skips caching; it never crashes or takes the
# API down. Local dev: docker compose -f docker-compose.dev.yml up -d
# (maps to host port 6380 — see that file for why).
# Use 127.0.0.1, not "localhost": on Windows, Python's getaddrinfo can
# resolve "localhost" to ::1 (IPv6) first, and Redis bound to IPv4-only
# then times out instead of falling back.
REDIS_URL=redis://127.0.0.1:6380/0

# --- Multi-layer caching (scale §2) ---
# Catalog/agent/industries caching via the shared CacheService: in-process
# L1 (always on when CACHE_ENABLED) + Redis L2 (only when REDIS_URL works).
# A Redis outage never breaks the API — it just skips L2 and reads the DB.
CACHE_ENABLED=true
CACHE_L1_ENABLED=true
CACHE_L1_MAX_ITEMS=5000
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_TTL_JITTER_PCT=10
CACHE_NEGATIVE_TTL_SECONDS=30

# --- Guardrails ---
# Per-user LLM requests allowed per minute (0 = unlimited).
RATE_LIMIT_PER_MIN=20
# Per-IP limit on unauthenticated routes (0 = unlimited).
RATE_LIMIT_IP_PER_MIN=60
# Per (email, agent) login request rate, on top of the failure lockout below.
LOGIN_RATE_LIMIT_PER_MIN=10
# Failed logins before exponential lockout kicks in for that (email, agent).
LOGIN_MAX_FAILURES=5
# Per-user daily token quota; cost guardrail (0 = unlimited).
DAILY_TOKEN_QUOTA_DEFAULT=200000
# Global cap on in-flight LLM calls (protects the provider's own rate limit).
GLOBAL_LLM_CONCURRENCY=10

# --- Internal endpoints & observability ---
# Protects /meta/* in production: requests must send X-Admin-Token: <value>.
# If empty in production, /meta/* is disabled entirely (404).
ADMIN_TOKEN=
# Log line format: text | json (json for log shippers / production).
LOG_FORMAT=text

# --- Pipeline ---
# Path (relative to repo root) to the agents source CSV.
AGENTS_CSV_PATH=data/agents_sample.csv
